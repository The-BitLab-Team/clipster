# Só para desenvolvimento (npm run dev). Copie para ".env" e preencha.
# O app instalado NUNCA lê este arquivo: lá, a chave é digitada em Configurações › IA
# e guardada no cofre do sistema. O ".env" está no .gitignore: não o envie para o repositório.

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# OpenAI: usada só quando o endereço do servidor for https://api.openai.com/v1
OPENAI_API_KEY=
